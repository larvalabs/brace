<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.larvalabs</groupId>
    <artifactId>brace</artifactId>
    <version>0.1.8-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>Brace</name>
    <description>Full-stack Java web framework — HTTP, database, templates, sessions, forms, jobs, mailer, ops dashboard. Plain Java, no DI container, no classpath scanning.</description>
    <url>https://github.com/larvalabs/brace</url>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <scm>
        <connection>scm:git:https://github.com/larvalabs/brace.git</connection>
        <developerConnection>scm:git:git@github.com:larvalabs/brace.git</developerConnection>
        <url>https://github.com/larvalabs/brace</url>
    </scm>

    <distributionManagement>
        <repository>
            <id>github</id>
            <name>GitHub Packages — larvalabs/brace</name>
            <url>https://maven.pkg.github.com/larvalabs/brace</url>
        </repository>
        <snapshotRepository>
            <id>github</id>
            <name>GitHub Packages — larvalabs/brace</name>
            <url>https://maven.pkg.github.com/larvalabs/brace</url>
        </snapshotRepository>
    </distributionManagement>

    <properties>
        <java.version>21</java.version>
        <maven.compiler.source>${java.version}</maven.compiler.source>
        <maven.compiler.target>${java.version}</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <jetty.version>12.0.33</jetty.version>
        <jackson.version>2.18.6</jackson.version>
        <junit.version>5.11.4</junit.version>

        <hibernate.version>7.0.10.Final</hibernate.version>
        <h2.version>2.3.232</h2.version>
        <postgresql.version>42.7.10</postgresql.version>
        <hikari.version>6.3.0</hikari.version>
        <flyway.version>10.22.0</flyway.version>
        <jte.version>3.2.1</jte.version>
        <jbcrypt.version>0.4</jbcrypt.version>
        <slf4j.version>2.0.17</slf4j.version>
        <testcontainers.version>1.21.3</testcontainers.version>
    </properties>

    <dependencies>
        <!-- Jetty 12 -->
        <dependency>
            <groupId>org.eclipse.jetty</groupId>
            <artifactId>jetty-server</artifactId>
            <version>${jetty.version}</version>
        </dependency>

        <!-- Jetty 12 WebSocket -->
        <dependency>
            <groupId>org.eclipse.jetty.websocket</groupId>
            <artifactId>jetty-websocket-jetty-server</artifactId>
            <version>${jetty.version}</version>
        </dependency>
        <!-- Jackson -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>${jackson.version}</version>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.datatype</groupId>
            <artifactId>jackson-datatype-jsr310</artifactId>
            <version>${jackson.version}</version>
        </dependency>

        <!-- JUnit 5 -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>

        <!-- JUnit Platform Console Standalone - shipped in distribution for `brace test` -->
        <dependency>
            <groupId>org.junit.platform</groupId>
            <artifactId>junit-platform-console-standalone</artifactId>
            <version>1.11.4</version>
        </dependency>

        <!-- Hibernate 7 (includes Jakarta Persistence API transitively) -->
        <dependency>
            <groupId>org.hibernate.orm</groupId>
            <artifactId>hibernate-core</artifactId>
            <version>${hibernate.version}</version>
        </dependency>
        <dependency>
            <groupId>org.hibernate.orm</groupId>
            <artifactId>hibernate-hikaricp</artifactId>
            <version>${hibernate.version}</version>
        </dependency>

        <!-- H2 Database (test scope) -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <version>${h2.version}</version>
            <scope>test</scope>
        </dependency>

        <!-- PostgreSQL JDBC driver (recommended production database; also used by the
             Testcontainers integration-test tier, where runtime scope is on the classpath) -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <version>${postgresql.version}</version>
            <scope>runtime</scope>
        </dependency>

        <!-- Testcontainers — real Postgres for the integration-test tier (*IT, `mvn verify`).
             Lets concurrency behaviors H2 can't reproduce (SKIP LOCKED, lock waits,
             READ COMMITTED races) and Postgres-native DDL be tested on the real path.
             See docs/2026-06-05-pg-testcontainers.md. -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>postgresql</artifactId>
            <version>${testcontainers.version}</version>
            <scope>test</scope>
        </dependency>

        <!-- HikariCP connection pool -->
        <dependency>
            <groupId>com.zaxxer</groupId>
            <artifactId>HikariCP</artifactId>
            <version>${hikari.version}</version>
        </dependency>

        <!-- Flyway database migrations -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
            <version>${flyway.version}</version>
        </dependency>
        <!-- Flyway 10 split per-database support out of flyway-core: core bundles only a
             handful of handlers (H2 among them, which is why the H2 test suite worked), but
             PostgreSQL — Brace's production database — needs this module or Flyway fails at
             startup with "No database found to handle jdbc:postgresql". Runtime scope (like the
             JDBC driver above) so it propagates transitively to downstream apps' runtime
             classpath. Caught by the Postgres testcontainer tier; H2-only tests never exercised
             the real prod migration path. -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
            <version>${flyway.version}</version>
            <scope>runtime</scope>
        </dependency>

        <!-- JTE template engine -->
        <dependency>
            <groupId>gg.jte</groupId>
            <artifactId>jte</artifactId>
            <version>${jte.version}</version>
        </dependency>

        <!-- jBCrypt password hashing -->
        <dependency>
            <groupId>org.mindrot</groupId>
            <artifactId>jbcrypt</artifactId>
            <version>${jbcrypt.version}</version>
        </dependency>

        <!-- Jakarta Mail (Angus Mail implementation, includes API) -->
        <dependency>
            <groupId>org.eclipse.angus</groupId>
            <artifactId>jakarta.mail</artifactId>
            <version>2.0.5</version>
        </dependency>

        <!-- slf4j → java.util.logging bridge. Without a provider, Jetty prints the
             "No SLF4J providers were found" warning and slf4j-routed logs vanish; with it,
             everything (Jetty, Hibernate via jboss-logging, Flyway, HikariCP) funnels into
             the single JUL sink that JulLogging configures (single-line format, WARNING
             default for the noisy libs). Version matches the slf4j-api Jetty pulls in. -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-jdk14</artifactId>
            <version>${slf4j.version}</version>
        </dependency>
    </dependencies>

    <build>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
            </resource>
            <!-- META-INF/brace-version.txt is filled with ${project.version} by Maven so
                 BraceVersion.get() can return the version both when running from the
                 packaged jar and from target/classes during development. -->
            <resource>
                <directory>src/main/resources-filtered</directory>
                <filtering>true</filtering>
            </resource>
            <resource>
                <directory>${project.basedir}</directory>
                <includes>
                    <include>BRACE-AGENTS.md</include>
                </includes>
                <targetPath>brace</targetPath>
            </resource>
            <!-- Ops reference companion: packaged at /brace/agent-ops-guide.md; written
                 into projects as BRACE-OPS.md by `brace new` and `brace agents-md`. -->
            <resource>
                <directory>${project.basedir}/docs</directory>
                <includes>
                    <include>agent-ops-guide.md</include>
                </includes>
                <targetPath>brace</targetPath>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <release>21</release>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.2</version>
            </plugin>
            <!-- Integration-test tier: runs *IT tests (e.g. the Postgres testcontainer
                 tests) in the integration-test/verify phases. `mvn test` (surefire) stays
                 H2-only and Docker-free; `mvn verify` additionally runs this tier. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <version>3.5.2</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-source-plugin</artifactId>
                <version>3.3.1</version>
                <executions>
                    <execution>
                        <id>attach-sources</id>
                        <goals><goal>jar-no-fork</goal></goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-assembly-plugin</artifactId>
                <version>3.7.1</version>
                <configuration>
                    <descriptors>
                        <descriptor>src/assembly/distribution.xml</descriptor>
                    </descriptors>
                    <appendAssemblyId>false</appendAssemblyId>
                    <finalName>brace-${project.version}</finalName>
                </configuration>
                <executions>
                    <execution>
                        <id>make-distribution</id>
                        <phase>package</phase>
                        <goals>
                            <goal>single</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <!-- Local dev convenience: extract the dist zip alongside it and refresh
                 the target/brace-current symlink. Lets a stable PATH entry like
                 `target/brace-current/bin` keep working across version bumps without
                 re-editing the shell profile. Runs after maven-assembly-plugin. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <version>3.1.0</version>
                <executions>
                    <execution>
                        <id>extract-dist-and-refresh-symlink</id>
                        <phase>package</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <target>
                                <unzip src="${project.build.directory}/brace-${project.version}.zip"
                                       dest="${project.build.directory}"/>
                                <chmod file="${project.build.directory}/brace-${project.version}/bin/brace"
                                       perm="755"/>
                                <symlink link="${project.build.directory}/brace-current"
                                         resource="brace-${project.version}"
                                         overwrite="true"/>
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
