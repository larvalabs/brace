@param String x
<a id="j1" href="javascript:go('${x}')">x</a>
<a id="j2" href="JavaScript:go('${x}')">x</a>
<a id="j3" href="  javascript:go(${x})">x</a>
<a id="j4" href="vbscript:go(&quot;${x}&quot;)">x</a>
<form id="j5" action="/ok"><button id="j6" formaction="javascript:send('${x}')">x</button></form>
<div id="j7" hx-get="javascript:${x}"></div>
<a id="j8" href="javascript:go('@template.xssCallee(u = x)')">x</a>
<a id="k1" href="javascript:void(0)">no data</a>
<a id="k2" href="mailto:${x}">x</a>
<a id="k3" href="/javascript:${x}">x</a>
<a id="k4" href="?next=javascript:${x}">x</a>
