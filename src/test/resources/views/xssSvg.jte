@param String x
@param String y
<svg id="f1"><script href="/a.js"/></svg><p id="p1">${x}</p><a id="a1" href="${x}">l</a><a id="a2" href="${x}:${y}">l</a>
<svg id="f2"><style/><a id="a3" href="${x}">s</a></svg><p id="p2">${x}</p>
<svg id="f3"><title>t</title><desc>d</desc><g><script xlink:href="/c.js" /></g><text id="t3">${x}</text><use id="a4" href="${x}"/></svg>
<svg id="f4"><foreignObject><p id="p4">${x}</p></foreignObject><script href="/d.js"/><a id="a5" href="${x}:${y}">s</a></svg>
<math><mi>n</mi><annotation-xml encoding="text/html"><a id="a6" href="${x}">l</a></annotation-xml></math><p id="p6">${x}</p>
<a id="a7" href="${x}" onclick="go('${x}')" title="${x}">l</a>
