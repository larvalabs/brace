@param String x
<svg><script id="g1">var a="${x}";</script></svg><p id="p1">${x}</p>
<svg><script id="g2"><![CDATA[ if (a < b) { var c = '${x}'; } ]]></script><text id="t2">${x}</text></svg>
<svg><style id="g3">a{color:${x}}</style></svg>
<script id="h1">var a = "${x}", t = `${x}`, r = /${x}/;</script>
<script id="j1" type="application/json">{"a":"${x}"}</script>
<p id="p2">${x}</p><a id="l1" href="${x}">l</a>
